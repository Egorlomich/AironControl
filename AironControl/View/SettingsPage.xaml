<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AironControl"
             x:Class="AironControl.SettingsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Верхний таб переключения -->
        <Grid BackgroundColor="#F5F5F5"
              ColumnDefinitions="*,*"
              HeightRequest="50"
              Padding="0">

            <Button x:Name="TabConnections"
                    Text="Мои подключения"
                    Grid.Column="0"
                    BackgroundColor="White"
                    TextColor="Black"
                    FontSize="16"/>

            <Button x:Name="TabEdit"
                    Text="Создать/Редактировать"
                    Grid.Column="1"
                    BackgroundColor="#F5F5F5"
                    TextColor="Black"
                    FontSize="16"/>
        </Grid>

        <!-- Вкладка Мои подключения -->
        <ScrollView x:Name="ConnectionsZone" Grid.Row="1" >
            <VerticalStackLayout Padding="10" Spacing="20">
                <!-- Блок активного подключения -->
                <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Текущее подключение" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="Black"/>

                        <Grid ColumnDefinitions="Auto,*" 
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto" 
                              ColumnSpacing="10" 
                              RowSpacing="10"
                              Padding="0,5">

                            <Label Text="Пресет:" Grid.Row="0" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Label x:Name="ActivePresetNameLabel" Grid.Row="0" Grid.Column="1"
                                   Text="Не выбран" FontSize="14" FontAttributes="Bold"/>

                            <Label Text="Хост:" Grid.Row="1" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Label x:Name="ActiveHostLabel" Grid.Row="1" Grid.Column="1"
                                   Text="-" FontSize="14"/>

                            <Label Text="Пользователь:" Grid.Row="2" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Label x:Name="ActiveUserLabel" Grid.Row="2" Grid.Column="1"
                                   Text="-" FontSize="14"/>

                            <Label Text="Порт:" Grid.Row="3" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Label x:Name="ActivePortLabel" Grid.Row="3" Grid.Column="1"
                                   Text="-" FontSize="14"/>

                            <Label Text="Модель:" Grid.Row="4" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Label x:Name="ActiveModelLabel" Grid.Row="4" Grid.Column="1"
                                   Text="-" FontSize="14"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                            <Button x:Name="TestConnectionButton" 
                                    Text="Проверить подключение"
                                    Clicked="OnTestConnection"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    HeightRequest="45"
                                    CornerRadius="8"/>

                            <Button x:Name="ConnectButton" 
                                    Text="Подключиться"
                                    Clicked="OnConnect"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    HeightRequest="45"
                                    CornerRadius="8"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Блок списка подключений -->
                <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Сохраненные подключения" 
               FontSize="18" 
               FontAttributes="Bold" 
               TextColor="Black"/>

                        <CollectionView x:Name="PresetsCollectionView"
               SelectionMode="None"
               EmptyView="Нет сохраненных подключений">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="10" Margin="5,5" BackgroundColor="#F8F8F8">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" 
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="10">

                                            <Label Text="{Binding settingsName}" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           Grid.Column="0" Grid.Row="0"/>

                                            <Label Text="{Binding host}" 
                           FontSize="12" 
                           TextColor="Gray"
                           Grid.Column="0" Grid.Row="1"/>

                                            <Button Text="Выбрать" 
                            Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                            VerticalOptions="Center"
                            Padding="10,5"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="5"
                            FontAttributes="Bold"
                            Clicked="OnSelectPresetClicked"/>

                                            <Button Text="Редактировать" 
                            Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                            VerticalOptions="Center"
                            Padding="10,5"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="5"
                            FontSize="14"
                            FontAttributes="Bold"
                            Clicked="OnEditPresetClicked"/>

                                            <Button Text="Удалить" 
                            Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                            VerticalOptions="Center"
                            Padding="10,5"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="5"
                            FontSize="14"
                            FontAttributes="Bold"
                            Clicked="OnDeletePresetClicked"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Вкладка Создать/Редактировать -->
        <ScrollView x:Name="EditZone" Grid.Row="1" IsVisible="False">
            <VerticalStackLayout Padding="16" Spacing="20">
                <!-- Блок создания/редактирования подключения -->
                <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="15">
                        <Label x:Name="EditTitleLabel"
                               Text="Создание нового подключения" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="Black"/>

                        <Grid ColumnDefinitions="Auto,*" 
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                              ColumnSpacing="10" 
                              RowSpacing="10">

                            <Label Text="Имя:" Grid.Row="0" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Entry x:Name="PresetNameEntry" Grid.Row="0" Grid.Column="1" 
                                   Placeholder="Введите название" FontSize="14"/>

                            <Label Text="Хост:" Grid.Row="1" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Entry x:Name="HostEntry" Grid.Row="1" Grid.Column="1" 
                                   Placeholder="Введите host или IP адрес" FontSize="14"/>

                            <Label Text="Пользователь:" Grid.Row="2" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Entry x:Name="UserEntry" Grid.Row="2" Grid.Column="1" 
                                   Placeholder="Введите имя пользователя" FontSize="14"/>

                            <Label Text="Порт:" Grid.Row="3" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Entry x:Name="PortEntry" Grid.Row="3" Grid.Column="1" 
                                   Placeholder="22" FontSize="14" Keyboard="Numeric"/>

                            <Label Text="Пароль:" Grid.Row="4" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Entry x:Name="PasswordEntry" Grid.Row="4" Grid.Column="1" 
                                   Placeholder="Введите пароль" IsPassword="True" FontSize="14"/>

                            <Label Text="Модель:" Grid.Row="5" Grid.Column="0" 
                                   VerticalOptions="Center" FontSize="14"/>
                            <Picker x:Name="ModelPicker" Grid.Row="5" Grid.Column="1" FontSize="14">
                                <Picker.Items>
                                    <x:String>Raspberry Pi 4</x:String>
                                    <x:String>Jetson Nano</x:String>
                                    <x:String>Custom</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>

                        <!-- Блок кнопок внизу -->
                        <Grid ColumnDefinitions="*,*,*" 
                              ColumnSpacing="10" 
                              Margin="0,20,0,0">

                            <Button x:Name="SavePresetButton" 
                                    Text="Сохранить"
                                    Clicked="OnSavePreset"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    HeightRequest="45"
                                    CornerRadius="8"
                                    Grid.Column="1"/>

                            <Button x:Name="CancelButton" 
                                    Text="Отмена"
                                    Clicked="OnCancel"
                                    BackgroundColor="#9E9E9E"
                                    TextColor="White"
                                    HeightRequest="45"
                                    CornerRadius="8"
                                    Grid.Column="2"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>